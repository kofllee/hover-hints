{
  "schemaVersion": 1,
  "id": "hover_hints",
  "version": "${version}",
  "name": "Hover Hints",
  "description": "Shows small contextual hints for hidden vanilla Minecraft mechanics",
  "authors": ["apathee"],
  "contact": {
    "homepage": "https://modrinth.com/user/apathee"
  },
  "license": "MIT",
  "icon": "assets/hover_hints/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.kofllee.hoverhints.HoverHints"
    ],
    "client": [
      "net.kofllee.hoverhints.client.HoverHintsClient"
    ],
    "modmenu": [
      "net.kofllee.hoverhints.client.config.HoverHintsModMenuIntegration"
    ]
  },
  "mixins": [
    "hover-hints.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
